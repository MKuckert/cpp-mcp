{
  "$schema": "https://opencode.ai/config.json",
  "model": "google/gemini-3.5-flash",
  "small_model": "google/gemini-3.1-flash-lite",
  "agent": {
    "build": {
      "disable": true,
    },
    "plan": {
      "disable": true,
    },
    "general": {
      "disable": true,
    },
    "explore": {
      "disable": true,
    },
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
    },
  },
}
